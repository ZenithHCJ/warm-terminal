{
  "name": "one-dark",
  "label": "One Dark",
  "description": "经典 Atom 灰蓝 · 深色",
  "terminal": {
    "scheme": {
      "name": "One Dark",
      "black": "#1e2127", "red": "#e06c75", "green": "#98c379", "yellow": "#e5c07b",
      "blue": "#61afef", "purple": "#c678dd", "cyan": "#56b6c2", "white": "#abb2bf",
      "brightBlack": "#5c6370", "brightRed": "#e06c75", "brightGreen": "#98c379", "brightYellow": "#e5c07b",
      "brightBlue": "#61afef", "brightPurple": "#c678dd", "brightCyan": "#56b6c2", "brightWhite": "#ffffff",
      "background": "#282c34", "foreground": "#abb2bf",
      "selectionBackground": "#3e4451", "cursorColor": "#528bff"
    },
    "appTheme": {
      "name": "One Dark",
      "tab": { "background": "#21252b", "unfocusedBackground": "#282c34", "showCloseButton": "hover" },
      "tabRow": { "background": "#282c34", "unfocusedBackground": "#21252b" },
      "window": { "applicationTheme": "dark" }
    }
  },
  "shell": {
    "promptDir": "\\[\\033[32m\\]",
    "promptGit": "\\[\\033[36m\\]",
    "batTheme": "OneHalfDark",
    "fzf": "--height 60% --layout=reverse --border --info=inline --color=bg+:#2c313a,bg:#282c34,spinner:#abb2bf,hl:#e06c75,fg:#abb2bf,header:#56b6c2,info:#e5c07b,pointer:#c678dd,marker:#98c379,fg+:#ffffff,prompt:#61afef,hl+:#e06c75,border:#3e4451"
  }
}
