{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "keybindings":
    [
        { "id": "Terminal.CopyToClipboard", "keys": "ctrl+c" },
        { "id": "Terminal.PasteFromClipboard", "keys": "ctrl+v" },
        { "id": "Terminal.DuplicatePaneAuto", "keys": "alt+shift+d" }
    ],
    "newTabMenu":
    [
        { "type": "remainingProfiles" }
    ],
    "profiles":
    {
        "defaults":
        {
            "font":
            {
                "face": "LXGWWenKaiMono NF",
                "size": 14
            },
            "colorScheme": "Latte Warm",
            "opacity": 100,
            "useAcrylic": false,
            "padding": "14, 10, 14, 10",
            "cursorShape": "bar",
            "cursorBlink": true,
            "scrollbarState": "hidden",
            "antialiasingMode": "cleartype",
            "startingDirectory": "%USERPROFILE%"
        },
        "list":
        [
            {
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "name": "PowerShell 7",
                "commandline": "pwsh.exe -NoLogo",
                "hidden": false
            },
            {
                "guid": "{a6f8b7c2-1d3e-4f5a-9b0c-2d3e4f5a6b7c}",
                "name": "Git Bash",
                "commandline": "%ProgramFiles%\\Git\\bin\\bash.exe -li",
                "hidden": false
            },
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "Windows PowerShell",
                "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
                "hidden": false
            },
            {
                "guid": "{0caa0dad-35da-5f21-a8ff-afceeeaa6101}",
                "name": "命令提示符",
                "commandline": "%SystemRoot%\\System32\\cmd.exe",
                "hidden": false
            }
        ]
    },
    "schemes":
    [
        {
            "name": "Latte Warm",
            "black": "#5c5f77",
            "red": "#d20f39",
            "green": "#40a02b",
            "yellow": "#df8e1d",
            "blue": "#1e66f5",
            "purple": "#ea76cb",
            "cyan": "#179299",
            "white": "#acb0be",
            "brightBlack": "#6c6f85",
            "brightRed": "#d20f39",
            "brightGreen": "#40a02b",
            "brightYellow": "#df8e1d",
            "brightBlue": "#1e66f5",
            "brightPurple": "#ea76cb",
            "brightCyan": "#179299",
            "brightWhite": "#bcc0cc",
            "background": "#f3ead9",
            "foreground": "#4c4f69",
            "selectionBackground": "#dfd3bf",
            "cursorColor": "#dc8a78"
        }
    ],
    "theme": "Latte Warm",
    "themes":
    [
        {
            "name": "Latte Warm",
            "tab":
            {
                "background": "#e9dcc6",
                "unfocusedBackground": "#f3ead9",
                "showCloseButton": "hover"
            },
            "tabRow":
            {
                "background": "#f3ead9",
                "unfocusedBackground": "#e9dcc6"
            },
            "window":
            {
                "applicationTheme": "light"
            }
        }
    ]
}
